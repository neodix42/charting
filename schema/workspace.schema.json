{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cryptodesk:workspace:v1",
  "title": "CryptoDesk portable workspace v1",
  "description": "First launch is one tab and one chart. Maxima are 20 tabs and 9 charts per tab.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "app": {
      "const": "cryptodesk"
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ]
    },
    "displayTimezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "chartRightGap": {
      "$ref": "#/$defs/chartRightGap"
    },
    "activeTabId": {
      "$ref": "#/$defs/uuid"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 400,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 300,
          "maximum": 16384
        },
        "maximized": {
          "type": "boolean"
        }
      },
      "required": [
        "width",
        "height",
        "maximized"
      ]
    },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/tab"
      }
    }
  },
  "required": [
    "schemaVersion",
    "app",
    "id",
    "theme",
    "displayTimezone",
    "activeTabId",
    "window",
    "tabs"
  ],
  "$defs": {
    "chartRightGap": {
      "description": "Global space after the most recent candle. Omission in legacy documents means ten bars; zero is allowed. Values are whole bars or CSS pixels.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": {
              "const": "bars"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            }
          },
          "required": [
            "unit",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": {
              "const": "pixels"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            }
          },
          "required": [
            "unit",
            "value"
          ]
        }
      ]
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "rowFractions": {
          "$ref": "#/$defs/tracks"
        },
        "columnFractions": {
          "$ref": "#/$defs/tracks"
        }
      },
      "required": [
        "rows",
        "columns",
        "rowFractions",
        "columnFractions"
      ],
      "oneOf": [
        {
          "properties": {
            "rows": {
              "const": 1
            },
            "columns": {
              "const": 1
            }
          }
        },
        {
          "properties": {
            "rows": {
              "const": 1
            },
            "columns": {
              "const": 2
            }
          }
        },
        {
          "properties": {
            "rows": {
              "const": 2
            },
            "columns": {
              "const": 1
            }
          }
        },
        {
          "properties": {
            "rows": {
              "const": 2
            },
            "columns": {
              "const": 2
            }
          }
        },
        {
          "properties": {
            "rows": {
              "const": 2
            },
            "columns": {
              "const": 3
            }
          }
        },
        {
          "properties": {
            "rows": {
              "const": 3
            },
            "columns": {
              "const": 2
            }
          }
        },
        {
          "properties": {
            "rows": {
              "const": 3
            },
            "columns": {
              "const": 3
            }
          }
        }
      ]
    },
    "priceRange": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "min",
            "max"
          ]
        }
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "live",
            "historical"
          ]
        },
        "fromSec": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 32503680000
        },
        "toSec": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 32503680000
        },
        "barSpacing": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "rightOffset": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        }
      },
      "required": [
        "mode",
        "fromSec",
        "toSec",
        "barSpacing",
        "rightOffset"
      ]
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "exchange": {
          "enum": [
            "binance",
            "bybit",
            "coinbase"
          ]
        },
        "market": {
          "enum": [
            "spot",
            "perpetual"
          ]
        },
        "instrument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "timeframe": {
          "enum": [
            "1m",
            "5m",
            "15m",
            "1h",
            "4h",
            "1d",
            "1w"
          ]
        },
        "chartType": {
          "enum": [
            "candlestick",
            "line"
          ]
        },
        "showVolume": {
          "type": "boolean"
        },
        "priceScale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "linear",
                "log"
              ]
            },
            "autoScale": {
              "type": "boolean"
            },
            "manualRange": {
              "$ref": "#/$defs/priceRange"
            }
          },
          "required": [
            "mode",
            "autoScale",
            "manualRange"
          ]
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "indicators": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/indicator"
          }
        },
        "drawings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/drawing"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exchange": {
                "const": "coinbase"
              }
            },
            "required": [
              "exchange"
            ]
          },
          "then": {
            "properties": {
              "market": {
                "const": "spot"
              }
            }
          }
        }
      ],
      "required": [
        "id",
        "exchange",
        "market",
        "instrument",
        "timeframe",
        "chartType",
        "showVolume",
        "priceScale",
        "view"
      ]
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "grid": {
          "$ref": "#/$defs/grid"
        },
        "charts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/chart"
          }
        }
      },
      "required": [
        "id",
        "name",
        "grid",
        "charts"
      ]
    },
    "drawingPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": {
          "description": "Absolute UTC Unix seconds, independent of chart size and timeframe.",
          "type": "integer",
          "minimum": 1,
          "maximum": 253402300799
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "time",
        "price"
      ]
    },
    "drawing": {
      "description": "A chart-owned drawing shown only for its exchange, market and native instrument, across all timeframes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "enum": [
            "arrowUp",
            "arrowDown",
            "horizontal",
            "trendline"
          ]
        },
        "exchange": {
          "enum": [
            "binance",
            "bybit",
            "coinbase"
          ]
        },
        "market": {
          "enum": [
            "spot",
            "perpetual"
          ]
        },
        "instrument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/drawingPoint"
          }
        }
      },
      "required": [
        "id",
        "type",
        "exchange",
        "market",
        "instrument",
        "points"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "trendline"
              }
            }
          },
          "then": {
            "properties": {
              "points": {
                "minItems": 2
              }
            }
          },
          "else": {
            "properties": {
              "points": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exchange": {
                "const": "coinbase"
              }
            }
          },
          "then": {
            "properties": {
              "market": {
                "const": "spot"
              }
            }
          }
        }
      ]
    },
    "indicator": {
      "description": "Optional per-chart indicator configuration. MACD fast < slow and globally unique indicator UUIDs are also enforced by backend semantic validation.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "sma"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "period": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                }
              },
              "required": [
                "period"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "lineWidth": {
              "description": "Line stroke width in CSS pixels. Omit to use two pixels.",
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "id",
            "type",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "ema"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "period": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                }
              },
              "required": [
                "period"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "lineWidth": {
              "description": "Line stroke width in CSS pixels. Omit to use two pixels.",
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "id",
            "type",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "ichimoku"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "conversion": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "base": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "spanB": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "displacement": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 500
                }
              },
              "required": [
                "conversion",
                "base",
                "spanB",
                "displacement"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "id",
            "type",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "macd"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fast": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "slow": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "signal": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                }
              },
              "required": [
                "fast",
                "slow",
                "signal"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "paneStretchFactor": {
              "description": "MACD pane height relative to the main chart pane. Omit to use the default layout.",
              "type": "number",
              "minimum": 0.001,
              "maximum": 1000
            }
          },
          "required": [
            "id",
            "type",
            "parameters"
          ]
        }
      ]
    }
  }
}
